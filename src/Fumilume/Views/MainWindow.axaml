<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fumilume.ViewModels"
        xmlns:v="using:Fumilume.Views"
        xmlns:s="using:Fumilume.Services"
        xmlns:m="using:Fumilume.Models"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="Fumilume.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/icon/app_icon_crystal_warm.png"
        Width="1180" Height="760"
        MinWidth="720" MinHeight="460"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="BorderOnly"
        Background="Transparent"
        UseLayoutRounding="True">
    <!-- 体裁は Styles/CommonStyles.axaml と Styles/MainWindowStyles.axaml。ここには構造だけを置く。
         TransparencyLevelHint とキャプションのグリフ切り替えは、設定（アクリル ON/OFF）と
         ウィンドウ状態に追従させる必要があるのでコードビハインドで設定する。 -->

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ReloadCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+M" Command="{Binding ToggleMarkdownPreviewCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding GoToLineCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />

        <!-- コマンドパレット。sakura のメニューバーは置けないので、機能が増えても入り口を変えない一覧を出す。 -->
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />

        <!-- キーボードマクロ。秀丸は Shift+F1 記録・Shift+F2 実行だが、Shift+F2 は
             sakura 由来の「前のブックマークへ」で埋まっているので実行を Shift+F5 に置く。 -->
        <KeyBinding Gesture="Shift+F1" Command="{Binding ToggleMacroRecordingCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding RunMacroCommand}" />

        <!-- sakura の既定キー（CKeyBind.cpp）のうち、Fumilume の既存割り当てと衝突しないものを引き継ぐ。
             Ctrl+G は sakura では Grep だが、Fumilume では既に「指定行へ移動」なのでそのまま残す。 -->
        <KeyBinding Gesture="Ctrl+F7" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.ToUpper}" />
        <KeyBinding Gesture="Ctrl+F6" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.ToLower}" />
        <KeyBinding Gesture="Ctrl+Alt+F5" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.TabToSpace}" />
        <KeyBinding Gesture="Ctrl+Shift+Alt+F5" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.SpaceToTab}" />
        <KeyBinding Gesture="Alt+F6" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.Base64Decode}" />
        <KeyBinding Gesture="Ctrl+I" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.DuplicateLine}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.DeleteLine}" />
        <KeyBinding Gesture="Alt+L" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.TrimLineStarts}" />

        <!-- ブックマークと対括弧（sakura の F2 系 / Ctrl+[ / Ctrl+]）。 -->
        <KeyBinding Gesture="F2" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.BookmarkNext}" />
        <KeyBinding Gesture="Shift+F2" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.BookmarkPrevious}" />
        <KeyBinding Gesture="Ctrl+F2" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.BookmarkToggle}" />
        <KeyBinding Gesture="Ctrl+Shift+F2" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.BookmarkClear}" />
        <KeyBinding Gesture="Ctrl+OemOpenBrackets" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.GoToMatchingBracket}" />
        <KeyBinding Gesture="Ctrl+OemCloseBrackets" Command="{Binding RunEditorCommandCommand}" CommandParameter="{x:Static s:EditorCommandId.GoToMatchingBracket}" />
    </Window.KeyBindings>

    <Panel>
        <!-- アクリルが使えない / 設定で切ったときに見せる単色の地。ApplyBackdrop が出し分ける。 -->
        <Border x:Name="FallbackLayer" Background="{DynamicResource FallbackWindowBg}" />
        <ExperimentalAcrylicBorder x:Name="AcrylicLayer" IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="{DynamicResource AcrylicTintColor}" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <!-- ぼかしの上に敷くテーマ色の膜。これが無いと壁紙の色に染まって本文の面から浮く。 -->
        <Border x:Name="AcrylicScrim" Background="{DynamicResource AcrylicScrimBrush}" IsHitTestVisible="False" />

        <Grid x:Name="WorkspaceGrid" RowDefinitions="32,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="176" MaxWidth="480" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- ===== タイトルバー =====
                 Background="Transparent" は必須。Avalonia は Background が未設定（null）の Panel を
                 ヒットテストの対象にしないため、これが無いと PointerPressed が発火せず
                 ウィンドウを掴んで動かせなくなる。 -->
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto"
                  Background="Transparent"
                  PointerPressed="TitleBar_PointerPressed"
                  DoubleTapped="TitleBar_DoubleTapped">
                <Grid Grid.Column="0" Width="{Binding #SidePanelRoot.Bounds.Width}"
                      Margin="16,0,10,0" ColumnDefinitions="Auto,Auto,*"
                      IsHitTestVisible="False">
                    <TextBlock Grid.Column="0" Text="Fumilume" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="1" Height="16" Margin="10,0"
                            Background="{DynamicResource Divider}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SelectedTab.TabTitle}"
                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- キャプションボタン（WindowDecorations=BorderOnly のためシステム側は描画されない） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Classes="caption" Click="Minimize_Click" AutomationProperties.Name="最小化">
                        <PathIcon Width="12" Height="12" Data="{StaticResource MinimizeIconGeometry}" />
                    </Button>
                    <Button Classes="caption" Click="MaximizeRestore_Click"
                            AutomationProperties.Name="最大化または元に戻す">
                        <Grid Width="12" Height="12">
                            <PathIcon x:Name="MaximizeIcon" Width="12" Height="12"
                                      Data="{StaticResource MaximizeIconGeometry}" />
                            <PathIcon x:Name="RestoreIcon" Width="12" Height="12" IsVisible="False"
                                      Data="{StaticResource RestoreIconGeometry}" />
                        </Grid>
                    </Button>
                    <Button Classes="caption close" Click="Close_Click" AutomationProperties.Name="閉じる">
                        <PathIcon Width="10" Height="10" Data="{StaticResource CloseIconGeometry}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== 左サイドのパネル =====
                 タブ一覧・アウトライン・ブックマークを同じ場所で切り替える。1 枚に 1 つの
                 用途しか持たせないので、機能が増えても幅と優先度が崩れない。
                 フォルダ横断検索の結果だけは 1 行 1 一致で横幅が要るため、ここではなく
                 中央のタブに出す（最小幅では場所と本文が同時に読めない）。 -->
            <Grid x:Name="SidePanelRoot" Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,0,10,4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                        <Button Classes="panelswitch" Classes.active="{Binding IsTabsPanel}"
                                Content="&#xE8A5;"
                                Command="{Binding SelectSidePanelCommand}"
                                CommandParameter="{x:Static vm:SidePanelKind.Tabs}"
                                AutomationProperties.Name="開いているもの" ToolTip.Tip="開いているもの" />
                        <Button Classes="panelswitch" Classes.active="{Binding IsOutlinePanel}"
                                Content="&#xE8FD;"
                                Command="{Binding SelectSidePanelCommand}"
                                CommandParameter="{x:Static vm:SidePanelKind.Outline}"
                                AutomationProperties.Name="アウトライン" ToolTip.Tip="アウトライン（見出し）" />
                        <Button Classes="panelswitch" Classes.active="{Binding IsBookmarksPanel}"
                                Content="&#xE735;"
                                Command="{Binding SelectSidePanelCommand}"
                                CommandParameter="{x:Static vm:SidePanelKind.Bookmarks}"
                                AutomationProperties.Name="ブックマーク" ToolTip.Tip="ブックマーク (Ctrl+F2)" />
                    </StackPanel>
                    <!-- 新しい文書だけは、追加先であるタブ一覧の近くに置く。 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                        <Button Classes="tabclose" Content="&#xE710;" Command="{Binding NewDocumentCommand}"
                                AutomationProperties.Name="新しい文書" ToolTip.Tip="新しい文書 (Ctrl+N)" />
                    </StackPanel>
                </Grid>

                <Panel Grid.Row="1">
                    <!-- 開いているもの。文書タブと設定タブが同じ一覧に並ぶ。項目の型は
                         WorkspaceTabViewModel で、表示に要る 3 つ（表題・アイコン・ツールチップ）
                         だけを基底が公開している。 -->
                    <ListBox Classes="verticaltabs" IsVisible="{Binding IsTabsPanel}"
                             ItemContainerTheme="{StaticResource VerticalTabItemTheme}"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding SelectedTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="タブ一覧">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                                <Grid Height="{DynamicResource TabItemHeight}"
                                      ColumnDefinitions="32,*,36" Background="Transparent">
                                    <TextBlock Grid.Column="0" Classes="icon" Text="{Binding TabGlyph}"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TabTitle}" FontSize="12.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"
                                               ToolTip.Tip="{Binding TabTooltip}" />
                                    <Button Grid.Column="2" Classes="tabclose" Command="{Binding CloseTabCommand}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.Name="タブを閉じる">
                                        <PathIcon Width="10" Height="10" Data="{StaticResource CloseIconGeometry}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- アウトライン。選ぶだけでその行へ飛ぶので、矢印キーで見出しを辿れる。 -->
                    <Panel IsVisible="{Binding IsOutlinePanel}">
                        <ListBox x:Name="OutlineList" Classes="sidelist"
                                 ItemsSource="{Binding Outline}"
                                 SelectedItem="{Binding SelectedOutlineItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="アウトライン">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="s:OutlineItem">
                                    <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Title}">
                                        <Border Grid.Column="0" Width="{Binding Indent}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="sideempty" IsVisible="{Binding !HasOutline}"
                                   Text="{Binding OutlineEmptyMessage}" />
                    </Panel>

                    <!-- ブックマーク。行番号と本文を並べ、選ぶとその行へ飛ぶ。 -->
                    <Panel IsVisible="{Binding IsBookmarksPanel}">
                        <ListBox x:Name="BookmarkList" Classes="sidelist"
                                 ItemsSource="{Binding Bookmarks}"
                                 SelectedItem="{Binding SelectedBookmark}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="ブックマーク">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BookmarkEntry">
                                    <Grid ColumnDefinitions="36,*" ToolTip.Tip="{Binding Display}">
                                        <TextBlock Grid.Column="0" Text="{Binding Location}" FontSize="12"
                                                   TextAlignment="Right" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="sideempty" IsVisible="{Binding !HasBookmarks}"
                                   Text="{Binding BookmarkEmptyMessage}" />
                    </Panel>
                </Panel>

            </Grid>

            <GridSplitter Grid.Row="1" Grid.Column="1"
                          ResizeDirection="Columns" Background="Transparent"
                          AutomationProperties.Name="タブ領域の幅を変更"
                          ToolTip.Tip="ドラッグしてタブ領域の幅を変更" />

            <!-- ===== コンテンツ島 ===== -->
            <!-- 角丸の切り抜きは ClipToBounds ではなくコードビハインドの Clip で行う
                 （RoundedClip の説明を参照）。ClipToBounds は矩形なので、下端のステータスバーが
                 島の角丸の枠線を塗りつぶして角が欠けて見える。 -->
            <Border x:Name="ContentIsland" Grid.Row="1" Grid.Column="2" Margin="0,0,6,6"
                    Background="{DynamicResource ContentBg}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    CornerRadius="14">
                <Panel>
                    <!-- 設定タブの中身。表示切替は包む Panel が持ち（DataContext はメイン側のまま）、
                         SettingsView 自身の DataContext だけを設定タブへ差し替える。
                         こうしないと SettingsView の中身が文書タブへバインドされる。 -->
                    <Panel IsVisible="{Binding IsSettingsSelected}">
                        <v:SettingsView DataContext="{Binding SettingsTab}" />
                    </Panel>

                    <Grid RowDefinitions="48,*,36" IsVisible="{Binding IsDocumentSelected}">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid x:Name="DocumentToolbar" ColumnDefinitions="Auto,*,Auto" Margin="8,4">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="OpenToolbarButton" Classes="command" Command="{Binding OpenCommand}"
                                            AutomationProperties.Name="ファイルを開く" ToolTip.Tip="ファイルを開く (Ctrl+O)">
                                        <TextBlock Classes="icon" Text="&#xE8E5;" />
                                    </Button>
                                    <Button Classes="command" Command="{Binding SaveCommand}" ToolTip.Tip="保存 (Ctrl+S)">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="icon" Text="&#xE74E;" />
                                            <TextBlock Text="保存" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="24" Margin="6,0" Background="{DynamicResource Divider}" />
                                    <Button Classes="command" Command="{Binding UndoCommand}"
                                            AutomationProperties.Name="元に戻す" ToolTip.Tip="元に戻す (Ctrl+Z)">
                                        <TextBlock Classes="icon" Text="&#xE7A7;" />
                                    </Button>
                                    <Button Classes="command" Command="{Binding RedoCommand}"
                                            AutomationProperties.Name="やり直す" ToolTip.Tip="やり直す (Ctrl+Y)">
                                        <TextBlock Classes="icon" Text="&#xE7A6;" />
                                    </Button>
                                    <Button Classes="command" Click="Find_Click"
                                            AutomationProperties.Name="検索" ToolTip.Tip="検索 (Ctrl+F)">
                                        <TextBlock Classes="icon" Text="&#xE721;" />
                                    </Button>
                                </StackPanel>

                                <!-- ===== 全機能の入口 =====
                                     ツールバーへ機能を足し続けると横に伸びて優先度が消える。常時出すのは
                                     上の 4 つだけにして、残りはここから名前で引く（sakura のメニューバーは
                                     タイトルバーを掴んで動かす作りと両立しないため置けない）。 -->
                                <Button Grid.Column="1" Classes="palette"
                                        Command="{Binding OpenCommandPaletteCommand}"
                                        AutomationProperties.Name="コマンドパレット"
                                        ToolTip.Tip="すべての機能を名前で探す (Ctrl+Shift+P)">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="icon" Text="&#xE721;" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                                   FontSize="12.5" Text="コマンドを名前で探す"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5"
                                                   Text="Ctrl+Shift+P"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Grid>
                                </Button>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                    <!-- 今の文書でしか意味のないものだけを、この位置へ文脈で出す。 -->
                                    <Button Classes="command" Command="{Binding ToggleMarkdownPreviewCommand}"
                                            IsVisible="{Binding SelectedDocument.CanShowMarkdownPreview}"
                                            AutomationProperties.Name="Markdown プレビュー切り替え"
                                            ToolTip.Tip="Markdown プレビュー (Ctrl+Shift+M)">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Border Padding="4,1" CornerRadius="4"
                                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                                                <TextBlock Text="MD" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding SelectedDocument.MarkdownPreviewToggleLabel}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SettingsToolbarButton" Classes="command"
                                            Command="{Binding OpenSettingsCommand}"
                                            AutomationProperties.Name="設定" ToolTip.Tip="設定 (Ctrl+,)">
                                        <TextBlock Classes="icon" Text="&#xE713;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource EditorBg}">
                            <Grid>
                                <ae:TextEditor x:Name="Editor" Classes="editor"
                                               IsVisible="{Binding SelectedDocument.IsEditorVisible}"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"
                                               Padding="14,12"
                                               AutomationProperties.Name="テキスト編集領域" />
                                <v:MarkdownPreview Markdown="{Binding SelectedDocument.Text}"
                                                   IsVisible="{Binding SelectedDocument.IsMarkdownPreview}"
                                                   AutomationProperties.Name="Markdown プレビュー" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource ContentBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,10,0">
                                <!-- 記録中と気付かないまま編集すると、意図しない手が混ざったマクロができる。 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0"
                                            VerticalAlignment="Center" IsVisible="{Binding IsRecordingMacro}">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource RecordingIndicator}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MacroRecordingText}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                                    <TextBlock x:Name="LineColumnStatus"
                                               Text="{Binding SelectedDocument.LineColumnText}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DocumentStatisticsStatus"
                                               Text="{Binding SelectedDocument.StatisticsText}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <Button Classes="statusitem" Content="{Binding SelectedDocument.EncodingLabel}"
                                            AutomationProperties.Name="文字コードを変更"
                                            ToolTip.Tip="文字コードを選択">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="UTF-8" Command="{Binding SetDocumentEncodingCommand}"
                                                          CommandParameter="{x:Static m:DocumentEncoding.Utf8}" />
                                                <MenuItem Header="UTF-8 with BOM" Command="{Binding SetDocumentEncodingCommand}"
                                                          CommandParameter="{x:Static m:DocumentEncoding.Utf8Bom}" />
                                                <MenuItem Header="UTF-16 LE" Command="{Binding SetDocumentEncodingCommand}"
                                                          CommandParameter="{x:Static m:DocumentEncoding.Utf16LittleEndian}" />
                                                <MenuItem Header="UTF-16 BE" Command="{Binding SetDocumentEncodingCommand}"
                                                          CommandParameter="{x:Static m:DocumentEncoding.Utf16BigEndian}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="statusitem" Content="{Binding SelectedDocument.NewLineLabel}"
                                            AutomationProperties.Name="改行コードを変更"
                                            ToolTip.Tip="改行コードを選択">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="CRLF" Command="{Binding SetDocumentNewLineCommand}"
                                                          CommandParameter="{x:Static m:DocumentNewLines.CrLf}" />
                                                <MenuItem Header="LF" Command="{Binding SetDocumentNewLineCommand}"
                                                          CommandParameter="{x:Static m:DocumentNewLines.Lf}" />
                                                <MenuItem Header="CR" Command="{Binding SetDocumentNewLineCommand}"
                                                          CommandParameter="{x:Static m:DocumentNewLines.Cr}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PDF は Windows 標準レンダラーで 1 ページずつ表示する。全ページを画像化しないため、
                         ページ数の多い文書でもメモリ使用量がページ数に比例しない。 -->
                    <Grid RowDefinitions="48,*,36" IsVisible="{Binding IsPdfSelected}">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,4">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="command" Command="{Binding SelectedPdf.PreviousPageCommand}"
                                            AutomationProperties.Name="前のページ" ToolTip.Tip="前のページ">
                                        <TextBlock Classes="icon" Text="&#xE76B;" />
                                    </Button>
                                    <TextBlock Margin="10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding SelectedPdf.PageStatus}" />
                                    <Button Classes="command" Command="{Binding SelectedPdf.NextPageCommand}"
                                            AutomationProperties.Name="次のページ" ToolTip.Tip="次のページ">
                                        <TextBlock Classes="icon" Text="&#xE76C;" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="{Binding SelectedPdf.TabTitle}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="command" Command="{Binding SelectedPdf.ZoomOutCommand}"
                                            AutomationProperties.Name="縮小" ToolTip.Tip="縮小">
                                        <TextBlock Classes="icon" Text="&#xE71F;" />
                                    </Button>
                                    <Button Classes="command" Command="{Binding SelectedPdf.ActualSizeCommand}"
                                            ToolTip.Tip="100% に戻す">
                                        <TextBlock MinWidth="48" HorizontalAlignment="Center"
                                                   Text="{Binding SelectedPdf.ZoomText}" />
                                    </Button>
                                    <Button Classes="command" Command="{Binding SelectedPdf.ZoomInCommand}"
                                            AutomationProperties.Name="拡大" ToolTip.Tip="拡大">
                                        <TextBlock Classes="icon" Text="&#xE8A3;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" Background="{DynamicResource SettingsPageBg}">
                            <Grid Margin="24">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Background="White" BoxShadow="0 4 18 0 #40000000">
                                    <Image Source="{Binding SelectedPdf.PageImage}" Stretch="None" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding SelectedPdf.IsLoading}"
                                           Foreground="{DynamicResource TextSecondary}" Text="PDF を描画しています…" />
                                <TextBlock MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding SelectedPdf.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="IndianRed" TextWrapping="Wrap"
                                           Text="{Binding SelectedPdf.ErrorMessage}" />
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="{DynamicResource ContentBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <Grid Margin="16,0,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Windows 標準 PDF レンダラー" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== フォルダ横断検索の結果 =====
                         秀丸の grep 結果に当たる面。1 行選ぶと該当ファイルの該当行へ飛ぶ
                         （ダブルクリックまたは Enter）。 -->
                    <Grid RowDefinitions="48,*,36" IsVisible="{Binding IsGrepSelected}">
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*" Margin="10,4">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="command" Command="{Binding GrepCommand}"
                                            ToolTip.Tip="新しい検索 (Ctrl+Shift+F)">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="icon" Text="&#xE81E;" />
                                            <TextBlock Text="新しい検索" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="command" Command="{Binding SelectedGrep.SearchAgainCommand}"
                                            AutomationProperties.Name="もう一度検索" ToolTip.Tip="もう一度検索">
                                        <TextBlock Classes="icon" Text="&#xE72C;" />
                                    </Button>
                                    <Button Classes="command" Command="{Binding SelectedGrep.CancelSearchCommand}"
                                            AutomationProperties.Name="検索を中止" ToolTip.Tip="検索を中止">
                                        <TextBlock Classes="icon" Text="&#xE711;" />
                                    </Button>
                                    <Border Width="1" Height="24" Margin="6,0" Background="{DynamicResource Divider}" />
                                    <Button Classes="command" Command="{Binding SelectedGrep.OpenSelectedCommand}"
                                            ToolTip.Tip="選んだ行へ移動 (Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="icon" Text="&#xE8A7;" />
                                            <TextBlock Text="その行へ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedGrep.TabTooltip}" />
                            </Grid>
                        </Border>

                        <Panel Grid.Row="1" Background="{DynamicResource EditorBg}">
                            <ListBox x:Name="GrepResultList" Classes="grepresults"
                                     ItemsSource="{Binding SelectedGrep.Matches}"
                                     SelectedItem="{Binding SelectedGrep.SelectedMatch}"
                                     DoubleTapped="GrepResults_DoubleTapped"
                                     KeyDown="GrepResults_KeyDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="検索結果">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GrepMatchItem">
                                        <Grid ColumnDefinitions="230,*" ToolTip.Tip="{Binding Tooltip}">
                                            <TextBlock Grid.Column="0" Text="{Binding Location}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedGrep.IsSearching}"
                                       Foreground="{DynamicResource TextSecondary}" Text="検索しています…" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedGrep.HasNoMatches}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="一致する行は見つかりませんでした" />
                        </Panel>

                        <Border Grid.Row="2" Background="{DynamicResource ContentBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <Grid Margin="16,0,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedGrep.Status}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="フォルダ横断検索" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== コマンドパレット =====
                         sakura のメニューバーは Fumilume には置けない（タイトルバーを掴んで動かす作りと
                         両立しない）。機能が 400 件規模まで増えても入り口が変わらないよう、
                         島の中へ浮かべる絞り込み一覧を出す。地の意匠は設定カードと同じものを使う。 -->
                    <Border IsVisible="{Binding IsCommandPaletteOpen}"
                            Background="{DynamicResource CommandPaletteScrim}"
                            PointerPressed="CommandPaletteScrim_PointerPressed">
                        <Border Width="560" MaxHeight="420" Margin="0,56,0,0"
                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                Background="{DynamicResource SettingsCardBg}"
                                BorderBrush="{DynamicResource SettingsCardBorder}" BorderThickness="1"
                                CornerRadius="14"
                                BoxShadow="0 12 32 0 #40000000">
                            <Grid RowDefinitions="Auto,*" Margin="8">
                                <TextBox x:Name="CommandPaletteInput" Grid.Row="0"
                                         Classes="settingsfield" Margin="4,4,4,8"
                                         PlaceholderText="コマンド名で絞り込み"
                                         Text="{Binding CommandPaletteQuery, Mode=TwoWay}"
                                         KeyDown="CommandPalette_KeyDown"
                                         AutomationProperties.Name="コマンドの絞り込み" />
                                <ListBox x:Name="CommandPaletteList" Grid.Row="1"
                                         Background="Transparent" BorderThickness="0"
                                         ItemsSource="{Binding CommandPaletteResults}"
                                         SelectedItem="{Binding SelectedPaletteCommand, Mode=TwoWay}"
                                         DoubleTapped="CommandPaletteList_DoubleTapped"
                                         KeyDown="CommandPalette_KeyDown"
                                         AutomationProperties.Name="コマンド候補">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CommandPaletteEntry">
                                            <Grid ColumnDefinitions="64,*,Auto" Height="30">
                                                <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Gesture}" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="12,0,4,0"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Border>
                </Panel>
            </Border>
        </Grid>
    </Panel>
</Window>
