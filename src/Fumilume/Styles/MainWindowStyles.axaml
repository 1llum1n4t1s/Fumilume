<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:aer="clr-namespace:AvaloniaEdit.Rendering;assembly=AvaloniaEdit"
        xmlns:v="using:Fumilume.Views">
    <!-- メインウィンドウの見た目。MainWindow.axaml には構造だけを残し、体裁はここへ集約する。 -->

    <Styles.Resources>
        <!-- タブ 1 行の厚み。設定「タブの厚み」から MainWindow のコードビハインドが書き換える。
             項目テンプレート側（MainWindow.axaml）の Grid.Height と、この ControlTheme の
             MinHeight の両方に効かせる必要があるため、値を 1 つのリソースへ寄せてある。 -->
        <x:Double x:Key="TabItemHeight">34</x:Double>

        <!-- 縦タブ 1 行分の見た目。ListBoxItem の既定テンプレートは選択枠を自前で描くため、
             角丸と塗り分けだけを持つテンプレートへ差し替える。 -->
        <ControlTheme x:Key="VerticalTabItemTheme" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="{DynamicResource TabItemHeight}" />
            <Setter Property="Background" Value="{DynamicResource TabIdleBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TabHoverBg}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource TabSelectedBg}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ListBox.verticaltabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 左サイドのパネル切り替え。今どの面を見ているかは塗りで示す（文言を入れる幅が無い）。 -->
    <Style Selector="Button.panelswitch">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.panelswitch:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}" />
    </Style>
    <Style Selector="Button.panelswitch.active">
        <Setter Property="Background" Value="{DynamicResource TabSelectedBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- アウトラインとブックマークの一覧。縦タブより行を詰めて、一度に見える件数を稼ぐ。 -->
    <Style Selector="ListBox.sidelist">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="ListBox.sidelist ListBoxItem">
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- 一覧が空のときの案内。空白のままだと「壊れている」と読めてしまう。 -->
    <Style Selector="TextBlock.sideempty">
        <Setter Property="Margin" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- フォルダ横断検索の結果。1 行 1 一致なので、行を詰めて一覧性を優先する。 -->
    <Style Selector="ListBox.grepresults">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
    </Style>

    <Style Selector="ListBox.grepresults ListBoxItem">
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- タブの閉じるボタンと、タブ一覧下の丸いアイコンボタン。 -->
    <Style Selector="Button.tabclose">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabclose:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}" />
    </Style>

    <!-- コマンドバーのボタン。アイコンのみ・アイコン＋文言のどちらでも高さが揃うようにする。 -->
    <Style Selector="Button.command">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.command:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}" />
    </Style>
    <Style Selector="Button.command:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- VS Code と同じく、ステータスの文字コード・改行コードそのものを選択入口にする。 -->
    <Style Selector="Button.statusitem">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.statusitem:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- コードから組み立てるプレビューにも動的リソースをスタイルとして適用する。
         VisualTree へ付く前の TryFindResource は色を取得できず、ダークテーマで本文が黒くなる。 -->
    <Style Selector="v|MarkdownPreview SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="v|MarkdownPreview Border.markdownquote">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="v|MarkdownPreview Border.markdowncode">
        <Setter Property="Background" Value="{DynamicResource SettingsPageBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}" />
    </Style>
    <Style Selector="v|MarkdownPreview Border.markdownrule">
        <Setter Property="Background" Value="{DynamicResource Divider}" />
    </Style>

    <!-- 全機能の入口。押すボタンではなく「名前を入れて引く欄」に見せたいので、
         検索欄と同じ角丸と枠を持たせる。 -->
    <Style Selector="Button.palette">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.palette:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}" />
    </Style>

    <Style Selector="ae|TextEditor.editor">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineNumbersForeground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="LineNumbersMargin" Value="12,0,10,0" />
    </Style>

    <!-- AvaloniaEdit の既定リンク色 Brushes.Blue はダーク背景で読めない。
         TextView の公式プロパティへテーマ色を渡し、リンクらしい下線も維持する。 -->
    <Style Selector="aer|TextView">
        <Setter Property="LinkTextForegroundBrush" Value="{DynamicResource EditorLinkForeground}" />
        <Setter Property="LinkTextUnderline" Value="True" />
    </Style>
</Styles>
