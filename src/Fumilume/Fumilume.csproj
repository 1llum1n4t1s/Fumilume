<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon Condition="'$(FumilumeTargetMac)' != 'true'">icon\app_crystal_warm.ico</ApplicationIcon>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);IL3053</NoWarn>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(FumilumeTargetMac)' != 'true'">win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FumilumeTargetMac)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.macos.lock.json</NuGetLockFilePath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);FUMILUME_MACOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(FumilumeTargetMac)' == 'true'">
    <Compile Remove="Services\FileAssociationService.cs" />
    <Compile Remove="Services\WindowsPdfRenderer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FumilumeTargetMac)' != 'true'">
    <Compile Remove="Services\MacFileAssociationService.cs" />
    <Compile Remove="Services\MacPdfRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon\app_icon_crystal_warm.png" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <None Update="Assets\Fonts\LICENSE-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SuperLightLogger" Version="1.0.17" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="VelopackUpdateDialog.Avalonia" Version="1.0.19" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fumilume.Tests" />
  </ItemGroup>
</Project>
