         確かめられない挙動の検証に使う（ウィンドウは開かずプロセス内で完結する）。 -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fumilume\Fumilume.csproj" />
  </ItemGroup>
</Project>
